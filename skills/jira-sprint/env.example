# Copy to ~/.jira-sync/.env and fill in:
#   mkdir -p ~/.jira-sync && cp env.example ~/.jira-sync/.env && chmod 600 ~/.jira-sync/.env
# Any of these can instead be set as real environment variables, which take precedence.

JIRA_BASE_URL=https://yourcompany.atlassian.net
# Cloud: your Atlassian email + an API token from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=you@yourcompany.com
JIRA_API_TOKEN=

# Scope. Either a project key (-> `project = "KEY" AND sprint in openSprints()`) ...
JIRA_PROJECT=SHOP
# ... or full JQL, which wins if both are set. Useful when a project has several boards:
# JIRA_JQL=sprint = "Payments Sprint 42"
# JIRA_JQL=project = SHOP AND sprint in openSprints() AND component = Checkout

# Optional: extra fields to include in ticket files, by display name.
# JIRA_EXTRA_FIELDS=Acceptance Criteria,Team

# Optional: "server" for Data Center / Server (JIRA_API_TOKEN is then a PAT; no email needed).
# Auto-detected as cloud when the URL contains .atlassian.net.
# JIRA_DEPLOYMENT=cloud

# Optional: where output goes (default: ./sprint next to this script).
# JIRA_SYNC_DIR=
